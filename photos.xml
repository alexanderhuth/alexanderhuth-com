---
layout: null
permalink: /photos.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}'s Photos</title>
  <id>{{ "/photos/" | absolute_url }}</id>
  <link href="{{ "/photos.xml" | absolute_url }}" rel="self" />
  <link href="{{ "/photos/" | absolute_url }}" />
  <author>
    <name>{{ site.author }}</name>
  </author>
  {% assign photos = site.photos %}
  {% if photos and photos.size > 0 %}
    {% assign photos = photos | sort: "time" | sort: "date" | reverse %}
    {% assign latest_time = photos[0].time | default: "00:00" %}
    <updated>{{ photos[0].date | date: "%Y-%m-%d" | append: "T" | append: latest_time | append: ":00+01:00" | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% endif %}
  {% for photo in photos limit: 20 %}
    {% assign photo_slug = photo.name | split: "." | first %}
    {% assign photo_image_filename = photo.image | split: "/" | last %}
    <entry>
      <title>📷 {{ photo.title | escape }}</title>
      <id>{{ "/photos/" | append: photo_slug | append: "/" | absolute_url }}</id>
      <link href="{{ "/photos/" | append: photo_slug | append: "/" | absolute_url }}" rel="alternate" type="text/html" />
      {% assign photo_time = photo.time | default: "00:00" %}
      <updated>{{ photo.date | date: "%Y-%m-%d" | append: "T" | append: photo_time | append: ":00+01:00" | date_to_xmlschema }}</updated>
      <summary>{{ photo.alt | escape }}{% if photo.location %} / {{ photo.location | escape }}{% endif %}</summary>
      <content type="html">
        <![CDATA[<p><img src="{{ "/images/720/" | append: photo_image_filename | absolute_url }}" alt="{{ photo.alt | escape }}" style="max-width:100%; height:auto;"></p><p>{{ photo.alt | escape }}{% if photo.location %} / {{ photo.location | escape }}{% endif %}</p>]]>
      </content>
    </entry>
  {% endfor %}
</feed>
