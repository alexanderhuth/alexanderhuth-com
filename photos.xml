---
layout: null
permalink: /photos.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}'s Photos</title>
  <id>{{ "/photos/" | absolute_url }}</id>
  <link href="{{ "/photos.xml" | absolute_url }}" rel="self" />
  <link href="{{ "/photos/" | absolute_url }}" />
  <author>
    <name>{{ site.author }}</name>
  </author>
  {% assign dates = site.data.photos | map: "date" | uniq | sort | reverse %}
  {% if dates and dates.size > 0 %}
    {% assign latest_date = dates[0] %}
    {% assign latest_photos = site.data.photos | where: "date", latest_date | sort: "time" | reverse %}
    <updated>{{ latest_photos[0].date | date: "%Y-%m-%d" | append: "T" | append: latest_photos[0].time | append: ":00+01:00" | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% endif %}
  {% for date in dates %}
    {% assign day_photos = site.data.photos | where: "date", date | sort: "time" | reverse %}
    {% for photo in day_photos %}
      {% assign photo_filename = photo.full | split: "/" | last %}
      <entry>
        <title>{{ photo.title | escape }}</title>
        <id>{{ "/photos/" | absolute_url }}</id>
        <link href="{{ "/photos/" | absolute_url }}" rel="alternate" type="text/html" />
        <updated>{{ photo.date | date: "%Y-%m-%d" | append: "T" | append: photo.time | append: ":00+01:00" | date_to_xmlschema }}</updated>
        <summary>{{ photo.alt | escape }}</summary>
        <content type="html">
          <![CDATA[<p><img src="{{ "/photos/720/" | append: photo_filename | absolute_url }}" alt="{{ photo.alt | escape }}" style="max-width:100%; height:auto;"></p><p>{{ photo.alt | escape }}{% if photo.location %} / {{ photo.location | escape }}{% endif %}</p>]]>
        </content>
      </entry>
    {% endfor %}
  {% endfor %}
</feed>
